[package]
name = "xfs_healer"
version = "@pkg_version@"
edition = "2021"

[profile.dev]
lto = @cargo_lto@

[profile.release]
lto = @cargo_lto@

# Be sure to update package_rust.m4 if you update the dependency list.
[dependencies]
clap = { version = "4.0.32", features = ["derive"] }
nix = { version = "0.26.1" }
serde_json = { version = "1.0.87" }
enumset = { version = "1.0.12" }
strum = { version = "0.19.2" }
strum_macros = { version = "0.19.2" }
