[Unit]
Description=Online XFS Metadata and Media Check for All Filesystems Failure Reporting
Documentation=man:xfs_scrub_all(8)

[Service]
Type=oneshot
Environment=EMAIL_ADDR=root
ExecStart=@pkg_lib_dir@/@pkg_name@/xfs_scrub_fail "${EMAIL_ADDR}" xfs_scrub_all_media
User=mail
Group=mail
SupplementaryGroups=systemd-journal
